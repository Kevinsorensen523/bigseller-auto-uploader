# Kredensial akun BigSeller. JANGAN commit file .env (hanya .env.example yang boleh masuk git).
BIGSELLER_USERNAME=
BIGSELLER_PASSWORD=

# URL
BIGSELLER_LOGIN_URL=https://www.bigseller.com/web/login.htm
BIGSELLER_LISTING_URL=https://www.bigseller.com/web/listing/shopee/active/index.htm?bsStatus=4

# Jalankan browser dengan UI (false) atau tanpa UI (true).
# Set false selama development/selector belum final.
HEADLESS=false

# Jeda antar aksi (klik/isi field) dalam milidetik, supaya halaman sempat render
# dan tidak kena rate-limit / salah input karena elemen belum siap.
ACTION_DELAY_MS=800

# Jeda antar produk (detik) saat upload banyak produk berturut-turut.
DELAY_BETWEEN_PRODUCTS_SEC=5

# Timeout default Playwright untuk menunggu elemen (milidetik).
DEFAULT_TIMEOUT_MS=15000
